{
  "info": {
    "name": "Android Auto API Test",
    "description": "API tests for Android Auto infotainment system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API - Get Vehicle Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Bluetooth connected is false', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.bluetooth_connected).to.eql(false);",
              "});",
              "pm.test('Media state is stopped', function() {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.media_state).to.eql('stopped');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/vehicle/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "vehicle", "status"]
        }
      }
    },
